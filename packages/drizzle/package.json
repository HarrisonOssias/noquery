    "src"
  ],
  "sideEffects": false,
  "dependencies": {
    "@noquery/core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.40.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
